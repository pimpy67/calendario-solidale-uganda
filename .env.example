# Configurazione Calendario Solidale

# Porta del server (Railway la imposta automaticamente)
PORT=3000

# URL base dell'applicazione (per webhook e condivisione)
BASE_URL=https://your-app.railway.app

# Password admin panel
ADMIN_PASSWORD=your_secure_password_here

# Satispay Business API
# Ottieni le credenziali da: https://business.satispay.com
SATISPAY_API_KEY=your_satispay_api_key
SATISPAY_SANDBOX=true

# Stripe API
# Ottieni le credenziali da: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Gmail per invio gift card (email regalo)
# Per generare App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=tuoindirizzo@gmail.com
GMAIL_APP_PASSWORD=la_tua_app_password

# Database (opzionale, default: ./server/database/calendario.db)
# Per Railway: usa /tmp per evitare problemi di permessi
DATABASE_PATH=/tmp/calendario.db
